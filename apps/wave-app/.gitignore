# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Wrangler (deploy do Cloudflare Pages): cache e estado locais do `wrangler
# dev`/`pages`. É gerado por máquina, muda a cada execução e não é fonte.
.wrangler/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Cópia estática dos documentos legais: PRODUTO DE BUILD, como o `dist/`.
# `npm run build:web` a regenera antes de exportar — e é esse mesmo comando que
# o Cloudflare Pages roda ao publicar. Versioná-la criaria a única falha que
# este gerador existe para impedir: o HTML publicado dizendo uma versão e o
# `documents.ts` dizendo outra.
/public/documentos/
