# WaveAI — variáveis do docker-compose (exemplo).
# Copie para `infra/.env` e ajuste. O `.env` real NÃO é versionado.
#
# ATENÇÃO: os valores abaixo são de DESENVOLVIMENTO LOCAL. Em qualquer ambiente
# compartilhado, gere segredos próprios e injete-os pelo ambiente/secret manager.

POSTGRES_USER=waveai
POSTGRES_PASSWORD=waveai_dev
POSTGRES_DB=waveai
POSTGRES_PORT=5432

API_PORT=8000
WAVEAI_API_APP_ENV=development

# OBRIGATÓRIO (ADR-0023): sem isto o `docker compose up` falha de propósito.
# Gere o SEU segredo — nunca reaproveite exemplos:  openssl rand -hex 32
WAVEAI_API_JWT_SECRET=
# Dev local roda em HTTP; o cookie `Secure` só trafega sob TLS.
WAVEAI_API_REFRESH_COOKIE_SECURE=false

# OBRIGATÓRIA (ADR-0026): cifragem em repouso do Result. Gere a sua:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WAVEAI_API_RESULT_ENCRYPTION_KEY=

# Provedor real de e-mail — SMTP do Gmail com SENHA DE APP (emenda à ADR-0044).
# Deixe VAZIO em dev para continuar vendo os e-mails no stdout do container.
# Preenchendo os três, o envio passa a ser real — inclusive em desenvolvimento,
# que é como se confere o provedor antes de confiar nele em produção.
#
# A senha é a de app, de 16 dígitos (exige 2FA na conta), NUNCA a senha da
# conta. Gere em: Conta Google > Segurança > Verificação em duas etapas >
# Senhas de app. Revogue e gere outra se suspeitar de vazamento.
WAVEAI_API_SMTP_HOST=
WAVEAI_API_SMTP_PORT=587
WAVEAI_API_SMTP_USER=
WAVEAI_API_SMTP_PASSWORD=
# Precisa casar com a conta que autentica, senão o Gmail reescreve ou recusa.
WAVEAI_API_EMAIL_FROM=

ANALYSIS_PORT=8001
WAVEAI_ANALYSIS_APP_ENV=development
