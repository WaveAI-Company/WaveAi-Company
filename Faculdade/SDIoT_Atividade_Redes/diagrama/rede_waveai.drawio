<mxfile host="drawio" type="device">
  <diagram id="rede-waveai" name="Rede do WaveAI">
    <mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título e regra de leitura (dentro do diagrama: sem legenda externa) -->
        <mxCell id="titulo" value="&lt;b style=&quot;font-size:22px&quot;&gt;WaveAI — rede do sensor ao painel (como está em produção, set/2026)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Seta = sentido de quem &lt;b&gt;inicia&lt;/b&gt; a conversa (não o sentido do dado). E1–E7 = enlaces da Seção 1. &lt;b&gt;Guarda&lt;/b&gt; = onde o dado fica em cada nó · &lt;b&gt;Na queda&lt;/b&gt; = o que acontece com ele quando a rede cai. Borda vermelha grossa = &lt;b&gt;ponto único de falha&lt;/b&gt;.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1680" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Zonas de propriedade da infraestrutura ===== -->
        <mxCell id="z_usuario" value="&lt;b&gt;Ambiente de quem capta&lt;/b&gt; (casa / consultório) — aparelhos do usuário" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=#F4F8FB;strokeColor=#5B7083;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="540" height="760" as="geometry" />
        </mxCell>
        <mxCell id="z_espectador" value="&lt;b&gt;Ambiente de quem assiste&lt;/b&gt; (titular em outra tela ou profissional vinculado)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=#F4F8FB;strokeColor=#5B7083;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="880" width="540" height="360" as="geometry" />
        </mxCell>
        <mxCell id="z_internet" value="&lt;b&gt;Internet pública&lt;/b&gt;&lt;br&gt;NÃO é nossa" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fillColor=#FAFAFA;strokeColor=#8A8A8A;verticalAlign=top;align=center;spacingTop=6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="300" height="1150" as="geometry" />
        </mxCell>
        <mxCell id="z_azure" value="&lt;b&gt;Microsoft Azure — Container Apps, região brazilsouth&lt;/b&gt; (infraestrutura da Microsoft; configuração nossa)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=#EEF4FF;strokeColor=#3B63C4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="90" width="740" height="640" as="geometry" />
        </mxCell>
        <mxCell id="z_neon" value="&lt;b&gt;Neon — sobre AWS sa-east-1&lt;/b&gt; (não é nossa)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=#EEFBF3;strokeColor=#2E8B57;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="780" width="360" height="250" as="geometry" />
        </mxCell>
        <mxCell id="z_google" value="&lt;b&gt;Google&lt;/b&gt; (não é nossa)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF7EC;strokeColor=#C27C0E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1340" y="780" width="360" height="250" as="geometry" />
        </mxCell>

        <!-- ===== Nós ===== -->
        <mxCell id="n_headset" value="&lt;b&gt;Headset NeuroSky MindWave Mobile 2&lt;/b&gt;&lt;br&gt;eletrodo FP1 + clipe de orelha → chip ThinkGear (512 amostras/s)&lt;br&gt;&lt;i&gt;firmware fechado da NeuroSky — não é nosso&lt;/i&gt;&lt;hr&gt;&lt;b&gt;Guarda:&lt;/b&gt; nada (não tem memória para o sinal)&lt;br&gt;&lt;b&gt;Na queda:&lt;/b&gt; as amostras do intervalo deixam de existir" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n_celular" value="&lt;b&gt;Celular Android — app WaveAI&lt;/b&gt; (Expo / React Native)&lt;br&gt;+ serviço em primeiro plano (captação com tela apagada)&lt;hr&gt;&lt;b&gt;Guarda:&lt;/b&gt; RAM — no máximo 255 amostras pendentes (&amp;lt; 0,5 s)&lt;br&gt;&lt;b&gt;Na queda do E2:&lt;/b&gt; amostras novas são descartadas — não há fila local nem reenvio (decisão: sinal bruto não é guardado)&lt;br&gt;&lt;b&gt;Na queda do E1:&lt;/b&gt; tenta reconectar a cada 2 s, por até 10 s&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;PONTO ÚNICO DE FALHA da captação&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=4;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n_roteador" value="&lt;b&gt;Roteador Wi-Fi do usuário ou rede 4G da operadora&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Guarda:&lt;/b&gt; nada · equipamento que NÃO é nosso&lt;br&gt;&lt;b&gt;Na queda:&lt;/b&gt; nada é retido" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_navegador" value="&lt;b&gt;Navegador — painel ao vivo e histórico&lt;/b&gt;&lt;br&gt;(app web WaveAI; rede de quem assiste, que NÃO é nossa)&lt;hr&gt;&lt;b&gt;Guarda:&lt;/b&gt; RAM — últimas janelas do gráfico; some ao fechar a aba&lt;br&gt;&lt;b&gt;Na queda do E5:&lt;/b&gt; mantém na tela o último valor recebido — sem aviso de que parou" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="460" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n_cloudflare" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;DNS de waveai.tec.br + Pages (CDN do site)&lt;hr&gt;&lt;b&gt;Guarda:&lt;/b&gt; arquivos estáticos do app web (código, sem dado de ninguém)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="1080" width="260" height="130" as="geometry" />
        </mxCell>

        <mxCell id="n_ingress" value="&lt;b&gt;Ingress externo&lt;/b&gt;&lt;br&gt;(proxy gerenciado pela Azure; TLS termina aqui)&lt;hr&gt;&lt;b&gt;Guarda:&lt;/b&gt; nada" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="975" y="430" width="225" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n_api" value="&lt;b&gt;API WaveAI&lt;/b&gt; (FastAPI) — &lt;b&gt;1 réplica só&lt;/b&gt; (maxReplicas 1)&lt;br&gt;gateway WebSocket /stream · SSE /live · REST&lt;hr&gt;&lt;b&gt;Guarda (RAM):&lt;/b&gt; sinal bruto da sessão até o encerramento (teto 4.000.000 amostras) · fila ao vivo de 64 eventos por espectador · limitador de login&lt;br&gt;&lt;b&gt;Na queda do E2:&lt;/b&gt; percebe pelo ping em 20–40 s (medido 27,6 s), gera o relatório com o que chegou (piso 1.024 amostras) e descarta o bruto&lt;br&gt;&lt;b&gt;Atenção:&lt;/b&gt; chamadas ao banco e à Analysis são síncronas — lentidão ali congela todas as sessões (medido)&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;PONTO ÚNICO DE FALHA: captação, ao vivo e histórico&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=4;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="390" width="390" height="275" as="geometry" />
        </mxCell>
        <mxCell id="n_analysis" value="&lt;b&gt;Analysis&lt;/b&gt; (FastAPI + biblioteca wave_eeg)&lt;br&gt;ingress INTERNO — inalcançável pela internet&lt;hr&gt;&lt;b&gt;Guarda:&lt;/b&gt; nada (serviço sem estado)&lt;br&gt;&lt;b&gt;Se cair:&lt;/b&gt; captação segue; ao vivo vira “indisponível”; sem relatório no fim&lt;br&gt;&lt;b&gt;Se ficar lenta:&lt;/b&gt; cada janela trava a API inteira por 5 s (medido)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="140" width="390" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n_banco" value="&lt;b&gt;PostgreSQL (Neon)&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Guarda (disco):&lt;/b&gt; contas, sessões, relatórios &lt;b&gt;cifrados&lt;/b&gt;, consentimentos, trilha de auditoria — enquanto a conta existir&lt;br&gt;&lt;b&gt;Na queda do E4:&lt;/b&gt; o já gravado fica. Sem resposta: a API inteira congela (medido 39,9 s). Recusando: a captação cai e a sessão fica “active”, sem relatório (medido)&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;PONTO ÚNICO DE FALHA dos dados&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=4;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="985" y="830" width="310" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n_gmail" value="&lt;b&gt;Servidor SMTP do Gmail&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Guarda:&lt;/b&gt; a mensagem, na fila e na caixa do Google&lt;br&gt;&lt;b&gt;Limite:&lt;/b&gt; 500 mensagens/dia&lt;br&gt;&lt;b&gt;Se recusar:&lt;/b&gt; o cadastro falha e pode ser repetido" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1365" y="830" width="310" height="150" as="geometry" />
        </mxCell>

        <!-- ===== Enlaces (seta = quem inicia) ===== -->
        <mxCell id="e1" value="&lt;b&gt;E1&lt;/b&gt; · Bluetooth Classic&lt;br&gt;RFCOMM / SPP · pacotes ThinkGear (com checksum)&lt;br&gt;o celular conecta; o headset transmite em fluxo contínuo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F3A5F;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_celular" target="n_headset">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2a" value="&lt;b&gt;E2&lt;/b&gt; · Wi-Fi 802.11 ou 4G&lt;br&gt;WebSocket sobre TLS (wss) · TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F3A5F;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_celular" target="n_roteador">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2b" value="&lt;b&gt;E2&lt;/b&gt; · internet&lt;br&gt;WebSocket sobre TLS (wss)&lt;br&gt;JSON: 256 amostras a cada 0,5 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F3A5F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_roteador" target="n_ingress">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="770" />
              <mxPoint x="930" y="466" />
            </Array>
            <mxPoint x="-150" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2c" value="&lt;b&gt;E2/E5&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F3A5F;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_ingress" target="n_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;E3&lt;/b&gt; · rede interna do ambiente&lt;br&gt;HTTPS interno / JSON · TCP&lt;br&gt;1 janela (1.024 amostras) a cada 2 s · timeout 5 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F3A5F;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_api" target="n_analysis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;E4&lt;/b&gt; · internet (Azure → AWS)&lt;br&gt;protocolo PostgreSQL sobre TLS · TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F3A5F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_api" target="n_banco">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="&lt;b&gt;E7&lt;/b&gt; · internet&lt;br&gt;SMTP + STARTTLS (porta 587) · TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F3A5F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_api" target="n_gmail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="&lt;b&gt;E5&lt;/b&gt; · internet&lt;br&gt;HTTPS · SSE (text/event-stream) + REST&lt;br&gt;o navegador assina; 1 evento a cada 2 s; keepalive 15 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F3A5F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_navegador" target="n_ingress">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="945" y="992" />
              <mxPoint x="945" y="520" />
            </Array>
            <mxPoint x="-170" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="&lt;b&gt;E6&lt;/b&gt; · internet&lt;br&gt;HTTPS (TLS 1.3) · download do app web" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F3A5F;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_navegador" target="n_cloudflare">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="1145" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
